# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Supabase service-role key — backend only, full DB access, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Gemini API key — used only by scripts/localize_dataset.py offline, never at request time.
GEMINI_API_KEY=
# Comma-separated origins allowed by CORS, e.g. http://localhost:3000
FRONTEND_ORIGINS=
