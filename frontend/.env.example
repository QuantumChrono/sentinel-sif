# Supabase project URL — safe to expose, used by the browser Auth client.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key — safe to expose, RLS-scoped. Never the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the FastAPI backend, e.g. http://127.0.0.1:8000 in local development.
NEXT_PUBLIC_API_BASE_URL=
